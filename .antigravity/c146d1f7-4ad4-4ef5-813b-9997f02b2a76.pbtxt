    replacement_infos {
      original_chunk {
        target_content: "/**\n * Dynamic full metadata loader for a single anime\n */\nexport async function getOnlineAnimeDetails(id: number): Promise<Anime> {\n  const cached = cache.details.get(id);\n  const now = Date.now();\n\n  if (cached && cached.expiry > now) {\n    return cached.data;\n  }\n\n  try {\n    // Look up via AniList using both MalID and AniList ID support\n    const query = `\n      query ($id: Int, $idMal: Int) {\n        Media (id: $id, idMal: $idMal, type: ANIME) {\n          id\n          idMal\n          title {\n            romaji\n            english\n            native\n          }\n          coverImage {\n            extraLarge\n            large\n            medium\n          }\n          bannerImage\n          description\n          genres\n          episodes\n          status\n          seasonYear\n          averageScore\n          popularity\n          studios(isMain: true) {\n            nodes {\n              name\n            }\n          }\n          type\n          trailer {\n            id\n            site\n          }\n          relations {\n            edges {\n              relationType\n              node {\n                id\n                idMal\n                title {\n                  english\n                  romaji\n                }\n                type\n                coverImage {\n                  large\n                }\n              }\n            }\n          }\n          characters (sort: [ROLE, RELEVANCE, ID], perPage: 12) {\n            edges {\n              role\n              node {\n                id\n                name {\n                  full\n                }\n                image {\n                  large\n                }\n              }\n              voiceActors (language: JAPANESE) {\n                id\n                name {\n                  full\n                }\n                image {\n                  large\n                }\n              }\n            }\n          }\n          recommendations (sort: [RATING_DESC, ID], perPage: 8) {\n            edges {\n              node {\n                mediaRecommendation {\n                  id\n                  idMal\n                  title {\n                    english\n                    romaji\n                  }\n                  type\n                  coverImage {\n                    large\n                  }\n                  description\n                  genres\n                  averageScore\n                  popularity\n                  seasonYear\n                  studios(isMain: true) {\n                    nodes {\n                      name\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    `;\n\n    // Query on idMal first\n    const res = await fetchWithRetry(\'https://graphql.anilist.co\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\', \'Accept\': \'application/json\' },\n      body: JSON.stringify({ query, variables: { idMal: id } }),\n    });\n\n    let mediaData: any = null;\n\n    if (res.ok) {\n      const result = await res.json();\n      mediaData = result.data?.Media;\n    } else {\n      // If MAL ID search fails, try searching by AniList ID directly (just in case they match)\n      const resAlt = await fetchWithRetry(\'https://graphql.anilist.co\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\', \'Accept\': \'application/json\' },\n        body: JSON.stringify({ query, variables: { id: id } }),\n      });\n      if (resAlt.ok) {\n        const resultAlt = await resAlt.json();\n        mediaData = resultAlt.data?.Media;\n      }\n    }\n\n    if (mediaData) {\n      const anime = mapAniListMediaToAnime(mediaData);\n      \n      // Also cache any recommendations returned by AniList so they are instantly accessible\n      if (mediaData.recommendations?.edges) {\n        const rawRecs = mediaData.recommendations.edges\n          .map((edge: any) => edge.node?.mediaRecommendation)\n          .filter(Boolean);\n        \n        const mappedRecs = rawRecs.map((r: any) => mapAniListMediaToAnime(r));\n        cache.recommendations.set(id, { data: mappedRecs, expiry: now + 3600000 }); // Cache recommendations for 1 hour\n      }\n\n      // Cache details for 24 hours (86,400,000 ms)\n      cache.details.set(id, { data: anime, expiry: now + 86400000 });\n      return anime;\n    } else {\n      console.warn(`[Details] AniList details not found for ID ${id}. Using Jikan fallback...`);\n      return await getOnlineAnimeDetailsJikan(id);\n    }\n  } catch (err: any) {\n    console.error(`[Details] AniList details failed for ID ${id}:`, err.message);\n    return await getOnlineAnimeDetailsJikan(id);\n  }\n}"
        replacement_content: "/**\n * Helper to bi-directionally merge metadata across providers\n */\nfunction mergeAnimeMetadata(target: Anime, source: Partial<Anime>): Anime {\n  return {\n    ...target,\n    title: target.title && target.title !== \'Unknown Title\' ? target.title : (source.title || target.title),\n    english_title: target.english_title && target.english_title !== \'Unknown Title\' ? target.english_title : (source.english_title || target.english_title),\n    genres: (target.genres && target.genres.length > 0) ? target.genres : (source.genres || []),\n    synopsis: (target.synopsis && target.synopsis !== \'No synopsis available.\' && target.synopsis.trim() !== \'\') ? target.synopsis : (source.synopsis || target.synopsis),\n    score: (target.score && target.score > 0) ? target.score : (source.score || target.score),\n    popularity: (target.popularity && target.popularity !== 99999) ? target.popularity : (source.popularity || target.popularity),\n    type: (target.type && target.type !== \'Unknown\') ? target.type : (source.type || target.type),\n    episodes: target.episodes || source.episodes || 0,\n    status: (target.status && target.status !== \'Unknown\' && target.status !== \'FINISHED\') ? target.status : (source.status || target.status),\n    year: target.year || source.year || 0,\n    studio: (target.studio && target.studio !== \'Unknown Studio\' && target.studio !== \'Unknown\') ? target.studio : (source.studio || target.studio),\n    image: target.image || source.image || \'\',\n    bannerImage: target.bannerImage || source.bannerImage,\n    trailer: target.trailer || source.trailer,\n    format: target.format || source.format || target.type || source.type || \'TV\',\n    season: target.season || source.season || \'Unknown\',\n    characters: (target.characters && target.characters.length > 0) ? target.characters : source.characters,\n    relations: (target.relations && target.relations.length > 0) ? target.relations : source.relations,\n  };\n}\n\n/**\n * Dynamic full metadata loader for a single anime\n */\nexport async function getOnlineAnimeDetails(id: number): Promise<Anime> {\n  const cached = cache.details.get(id);\n  const now = Date.now();\n\n  if (cached && cached.expiry > now) {\n    return cached.data;\n  }\n\n  let mainAnime: Anime | null = null;\n\n  try {\n    // Look up via AniList using both MalID and AniList ID support\n    const query = `\n      query ($id: Int, $idMal: Int) {\n        Media (id: $id, idMal: $idMal, type: ANIME) {\n          id\n          idMal\n          title {\n            romaji\n            english\n            native\n          }\n          coverImage {\n            extraLarge\n            large\n            medium\n          }\n          bannerImage\n          description\n          genres\n          episodes\n          status\n          seasonYear\n          averageScore\n          popularity\n          studios(isMain: true) {\n            nodes {\n              name\n            }\n          }\n          type\n          format\n          season\n          trailer {\n            id\n            site\n          }\n          relations {\n            edges {\n              relationType\n              node {\n                id\n                idMal\n                title {\n                  english\n                  romaji\n                }\n                type\n                coverImage {\n                  large\n                }\n              }\n            }\n          }\n          characters (sort: [ROLE, RELEVANCE, ID], perPage: 12) {\n            edges {\n              role\n              node {\n                id\n                name {\n                  full\n                }\n                image {\n                  large\n                }\n              }\n              voiceActors (language: JAPANESE) {\n                id\n                name {\n                  full\n                }\n                image {\n                  large\n                }\n              }\n            }\n          }\n          recommendations (sort: [RATING_DESC, ID], perPage: 40) {\n            edges {\n              node {\n                mediaRecommendation {\n                  id\n                  idMal\n                  title {\n                    english\n                    romaji\n                  }\n                  type\n                  format\n                  season\n                  coverImage {\n                    large\n                  }\n                  description\n                  genres\n                  averageScore\n                  popularity\n                  seasonYear\n                  studios(isMain: true) {\n                    nodes {\n                      name\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    `;\n\n    // Query on idMal first\n    const res = await fetchWithRetry(\'https://graphql.anilist.co\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\', \'Accept\': \'application/json\' },\n      body: JSON.stringify({ query, variables: { idMal: id } }),\n    });\n\n    let mediaData: any = null;\n\n    if (res.ok) {\n      const result = await res.json();\n      mediaData = result.data?.Media;\n    } else {\n      // If MAL ID search fails, try searching by AniList ID directly (just in case they match)\n      const resAlt = await fetchWithRetry(\'https://graphql.anilist.co\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\', \'Accept\': \'application/json\' },\n        body: JSON.stringify({ query, variables: { id: id } }),\n      });\n      if (resAlt.ok) {\n        const resultAlt = await resAlt.json();\n        mediaData = resultAlt.data?.Media;\n      }\n    }\n\n    if (mediaData) {\n      mainAnime = mapAniListMediaToAnime(mediaData);\n      \n      // Also cache any recommendations returned by AniList so they are instantly accessible\n      if (mediaData.recommendations?.edges) {\n        const rawRecs = mediaData.recommendations.edges\n          .map((edge: any) => edge.node?.mediaRecommendation)\n          .filter(Boolean);\n        \n        const mappedRecs = rawRecs.map((r: any) => mapAniListMediaToAnime(r));\n        cache.recommendations.set(id, { data: mappedRecs, expiry: now + 3600000 }); // Cache recommendations for 1 hour\n      }\n    }\n  } catch (err: any) {\n    console.error(`[Details] AniList details failed for ID ${id}:`, err.message);\n  }\n\n  let jikanAnime: Anime | null = null;\n  try {\n    // If AniList failed OR returned an incomplete dataset, load Jikan to enrich it\n    const needsSupplement = !mainAnime || \n      !mainAnime.studio || mainAnime.studio === \'Unknown Studio\' ||\n      mainAnime.score === 0 || \n      !mainAnime.synopsis || mainAnime.synopsis === \'No synopsis available.\' ||\n      !mainAnime.characters || mainAnime.characters.length === 0;\n\n    if (needsSupplement) {\n      jikanAnime = await getOnlineAnimeDetailsJikan(id);\n    }\n  } catch (err: any) {\n    console.error(`[Details] Jikan supplement loader failed for ID ${id}:`, err.message);\n  }\n\n  // Final Merged object\n  let finalAnime: Anime;\n  if (mainAnime && jikanAnime) {\n    finalAnime = mergeAnimeMetadata(mainAnime, jikanAnime);\n  } else if (mainAnime) {\n    finalAnime = mainAnime;\n  } else if (jikanAnime) {\n    finalAnime = jikanAnime;\n\n    // Try finding banner on AniList based on the english title\n    try {\n      const searchRes = await searchOnlineAnime(finalAnime.english_title || finalAnime.title, [], \'All\', 0, \'popularity\', 3, 0);\n      if (searchRes && searchRes.data && searchRes.data.length > 0) {\n        const bestMatch = searchRes.data.find(a => a.mal_id === finalAnime.mal_id) || searchRes.data[0];\n        finalAnime = mergeAnimeMetadata(finalAnime, {\n          bannerImage: bestMatch.bannerImage,\n          format: bestMatch.format || finalAnime.format,\n          season: bestMatch.season || finalAnime.season,\n        });\n      }\n    } catch (e) {\n      console.warn(\'[Details Fallback] Failed fetching AniList banner for Jikan details:\', e);\n    }\n  } else {\n    // Emergency global pool lookup\n    const local = globalAnimePool.get(id);\n    if (local) {\n      finalAnime = local;\n    } else {\n      throw new Error(`Anime details completely unavailable for ID ${id}`);\n    }\n  }\n\n  // Guarantee clean human defaults and eliminate blanks/0.0 values\n  if (!finalAnime.studio || finalAnime.studio.trim() === \'\' || finalAnime.studio === \'Unknown Studio\') {\n    finalAnime.studio = \'Unknown Studio\';\n  }\n  if (!finalAnime.status || finalAnime.status.trim() === \'\') {\n    finalAnime.status = \'Unknown\';\n  }\n  if (!finalAnime.synopsis || finalAnime.synopsis.trim() === \'\') {\n    finalAnime.synopsis = \'No synopsis available.\';\n  }\n  if (!finalAnime.format) {\n    finalAnime.format = finalAnime.type || \'TV\';\n  }\n  if (!finalAnime.season || finalAnime.season === \'Unknown\') {\n    finalAnime.season = \'Unknown\';\n  }\n\n  cache.details.set(id, { data: finalAnime, expiry: now + 86400000 });\n  return finalAnime;\n}"
      }
